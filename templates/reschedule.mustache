{{!
    @template local_reschedule/reschedule

    Template for course activities scheduling and timeline page.

    @copyright  2026 Juan Pablo de Castro
    @author     Juan Pablo de Castro <juan.pablo.de.castro@gmail.com>
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div class="local-reschedule-container mb-4{{#readonly}} is-readonly{{/readonly}}" id="reschedule-page-root"
    data-courseid="{{courseid}}"
    data-editing="{{#editing}}1{{/editing}}{{^editing}}0{{/editing}}"
    data-course-start="{{coursestart}}"
    data-course-end="{{courseend}}"
    data-timeline-start="{{timelineStart}}"
    data-timeline-end="{{timelineEnd}}"
    data-save-url="{{saveurl}}"
    data-weekify-url="{{weekifyurl}}"
    data-sesskey="{{sesskey}}"
    data-lang="{{language}}"
    data-error-saving="{{#str}}error_saving, local_reschedule{{/str}}"
    data-error-saving-header="{{#str}}error_saving_header, local_reschedule{{/str}}"
    data-error-saving-affected="{{#str}}error_saving_affected, local_reschedule{{/str}}"
    data-error-saving-pending="{{#str}}error_saving_pending, local_reschedule{{/str}}"
    data-schedulesaved="{{#str}}schedulesaved, local_reschedule{{/str}}"
    data-activity-before-timeline="{{#str}}activitybeforetimeline, local_reschedule{{/str}}"
    data-activity-after-timeline="{{#str}}activityaftertimeline, local_reschedule{{/str}}"
    data-activity-start-disabled="{{#str}}activitystartdisabled, local_reschedule{{/str}}"
    data-activity-end-disabled="{{#str}}activityenddisabled, local_reschedule{{/str}}"
    data-no-schedulable-changes="{{#str}}noschedulablechanges, local_reschedule{{/str}}"
    data-subactivity-parent-bounds="{{#str}}subactivityparentbounds, local_reschedule{{/str}}"
    data-kuet-activity-derived-hint="{{#str}}kuetactivityderivedhint, local_reschedule{{/str}}"
    data-availability-restriction="{{#str}}availabilityrestriction, local_reschedule{{/str}}"
    data-availability-restriction-hint="{{#str}}availabilityrestrictionhint, local_reschedule{{/str}}"
    data-milestone-date="{{#str}}milestonedate, local_reschedule{{/str}}"
    data-effort-drops="{{#str}}effortdrops, local_reschedule{{/str}}"
    data-effort-scale="{{#str}}effortscale, local_reschedule{{/str}}"
    data-effort-settings="{{#str}}effortsettings, local_reschedule{{/str}}"
    data-effort-label="{{#str}}effortlabel, local_reschedule{{/str}}"
    data-effort-points="{{#str}}effortpoints, local_reschedule{{/str}}"
    data-weekify-save-first="{{#str}}weekifysavefirst, local_reschedule{{/str}}"
    data-weekify-loading="{{#str}}weekifyloading, local_reschedule{{/str}}"
    data-weekify-error="{{#str}}weekifyerror, local_reschedule{{/str}}"
    data-weekify-moved="{{#str}}weekifymoved, local_reschedule{{/str}}"
    data-weekify-failed="{{#str}}weekifyfailed, local_reschedule{{/str}}"
    data-weekify-more="{{#str}}weekifymore, local_reschedule{{/str}}"
    data-weekify-moves="{{#str}}weekifymoves, local_reschedule{{/str}}"
    data-selection-mode="{{#str}}selectionmode, local_reschedule{{/str}}"
    data-selection-activities="{{#str}}activities, local_reschedule{{/str}}"
    data-selection-drag-hint="{{#str}}selectiondraghint, local_reschedule{{/str}}"
    data-selection-selected="{{#str}}selectionselected, local_reschedule{{/str}}"
    data-select-activity="{{#str}}selectactivity, local_reschedule{{/str}}"
    data-selection-empty="{{#str}}selectionempty, local_reschedule{{/str}}"
    data-selection-weekify-empty="{{#str}}selectionweekifyempty, local_reschedule{{/str}}"
    data-readonly-notice="{{#str}}readonlynotice, local_reschedule{{/str}}"
    data-editmode-required="{{#str}}editmoderequired, local_reschedule{{/str}}"
    data-autosequence-blackout-empty="{{#str}}autosequenceblackoutempty, local_reschedule{{/str}}">
    <!-- Header card with controls -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                <div>
                    <h3 class="card-title fw-bold text-dark mb-1">
                        <i class="fa fa-calendar-check-o text-primary me-2" aria-hidden="true"></i>
                        {{#str}}rescheduletitle, local_reschedule{{/str}}
                    </h3>
                    <p class="text-muted mb-0 small">
                        {{#str}}rescheduledesc, local_reschedule{{/str}}
                    </p>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <a href="{{courseurl}}" class="btn btn-outline-secondary btn-sm">
                        <i class="fa fa-arrow-left me-1" aria-hidden="true"></i>{{#str}}back, moodle{{/str}}
                    </a>
                    <button type="button" class="btn btn-outline-primary btn-sm" id="btn-autosequence"{{^editing}} disabled{{/editing}}>
                        <i class="fa fa-magic me-1" aria-hidden="true"></i>{{#str}}autosequence, local_reschedule{{/str}}
                    </button>
                    {{#showweekify}}
                    <button type="button" class="btn btn-outline-primary btn-sm" id="btn-weekify"{{^editing}} disabled{{/editing}}>
                        <i class="fa fa-calendar me-1" aria-hidden="true"></i>{{#str}}weekify, local_reschedule{{/str}}
                    </button>
                    {{/showweekify}}
                    <button type="button" class="btn btn-outline-danger btn-sm" id="btn-reset"{{^editing}} disabled{{/editing}}>
                        <i class="fa fa-undo me-1" aria-hidden="true"></i>{{#str}}resetschedule, local_reschedule{{/str}}
                    </button>
                    <button type="button" class="btn btn-primary btn-sm px-3" id="btn-save" disabled>
                        <i class="fa fa-floppy-o me-1" aria-hidden="true"></i>{{#str}}savechanges, moodle{{/str}}
                    </button>
                </div>
            </div>

            <!-- Course Timeframe Meta -->
            <div class="d-flex flex-wrap align-items-center gap-2 pt-2 border-top">
                <span class="badge bg-light text-dark border py-2 px-3">
                    <i class="fa fa-play text-success me-1" aria-hidden="true"></i>
                    <strong>{{#str}}datestart, local_reschedule{{/str}}:</strong> {{coursestartstr}}
                </span>
                <span class="badge bg-light text-dark border py-2 px-3">
                    <i class="fa fa-stop text-danger me-1" aria-hidden="true"></i>
                    <strong>{{#str}}dateend, local_reschedule{{/str}}:</strong> {{courseendstr}}
                </span>
                <span class="badge bg-light text-secondary border py-2 px-3">
                    <i class="fa fa-tasks me-1" aria-hidden="true"></i>
                    <strong>{{#str}}activities, local_reschedule{{/str}}:</strong> {{itemscount}}
                </span>
                <div id="reschedule-unsaved-alert" class="badge bg-warning text-dark py-2 px-3 invisible animate__animated animate__fadeIn">
                    <i class="fa fa-exclamation-triangle me-1" aria-hidden="true"></i>{{#str}}unsavedchanges, local_reschedule{{/str}}
                </div>
            </div>
        </div>
    </div>

    {{#readonly}}
    <div class="alert alert-info d-flex align-items-center gap-2" role="status">
        <i class="fa fa-lock" aria-hidden="true"></i>{{#str}}readonlynotice, local_reschedule{{/str}}
    </div>
    {{/readonly}}

    {{^hasitems}}
    <div class="alert alert-info shadow-sm" role="alert">
        <i class="fa fa-info-circle me-1" aria-hidden="true"></i>
        {{#str}}noactivitiesfound, local_reschedule{{/str}}
    </div>
    {{/hasitems}}

    {{#hasitems}}
    <!-- Interactive Timeline Board Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-0">
            <div id="reschedule-timeline-app" class="quest-timeline-wrapper position-relative" style="min-height: 250px;">
                <!-- Timeline elements built by AMD reschedule_calendar.js -->
            </div>
        </div>
    </div>

    <!-- Drag Floating HUD Tooltip -->
    <div id="reschedule-drag-hud" class="quest-drag-hud position-fixed shadow-lg rounded px-3 py-2 text-white d-none" style="z-index: 1050; pointer-events: none; font-size: 0.8rem;">
        <div class="fw-bold text-truncate" id="hud-title"></div>
        <div class="smaller opacity-75" id="hud-dates"></div>
    </div>

    <!-- Table representation of activities -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="card-title mb-0 fw-bold small text-uppercase text-secondary">
                <i class="fa fa-list me-2 text-primary" aria-hidden="true"></i>
                {{#str}}activities, local_reschedule{{/str}}
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="reschedule-table">
                    <thead class="table-light text-secondary smaller text-uppercase">
                        <tr>
                            <th scope="col" style="min-width: 250px;">{{#str}}activity, local_reschedule{{/str}}</th>
                            <th scope="col" style="width: 160px;">{{#str}}type, local_reschedule{{/str}}</th>
                            <th scope="col" style="width: 170px;">{{#str}}datestart, local_reschedule{{/str}}</th>
                            <th scope="col" style="width: 170px;">{{#str}}dateend, local_reschedule{{/str}}</th>
                            <th scope="col" style="width: 120px;" class="text-center">{{#str}}duration, local_reschedule{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        {{#items}}
                        <tr id="reschedule-row-{{id}}" data-itemid="{{id}}" {{#issubtype}}data-parentkey="{{parentkey}}"{{/issubtype}} class="{{#issubtype}}table-light text-muted subtask-row d-none{{/issubtype}}{{^interactive}} reschedule-item-disabled{{/interactive}}">
                            <td class="{{#issubtype}}ps-4{{/issubtype}} text-nowrap">
                                {{#haschildren}}
                                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-1 me-2 toggle-subtasks" data-parentkey="{{id}}" aria-expanded="false" title="{{#str}}togglesubtasks, local_reschedule{{/str}}">
                                    <i class="fa fa-plus" aria-hidden="true"></i>
                                </button>
                                {{/haschildren}}
                                {{^haschildren}}
                                {{^issubtype}}
                                <span class="d-inline-block" style="width: 22px;"></span>
                                {{/issubtype}}
                                {{/haschildren}}
                                {{#issubtype}}
                                <i class="fa fa-level-up fa-rotate-90 text-muted me-2" aria-hidden="true"></i>
                                {{/issubtype}}
                                {{#iconurl}}
                                <img src="{{iconurl}}" class="activityicon me-2" style="width: 18px; height: 18px; vertical-align: middle; object-fit: contain;" alt="">
                                {{/iconurl}}
                                {{#viewurl}}<a href="{{viewurl}}" class="{{^issubtype}}text-dark{{/issubtype}} reschedule-activity-link">{{title}}</a>{{/viewurl}}
                                {{^viewurl}}<strong class="{{^issubtype}}text-dark{{/issubtype}}">{{title}}</strong>{{/viewurl}}
                            </td>
                            <td>
                                <span class="badge {{#issubtype}}bg-light text-secondary border{{/issubtype}}{{^issubtype}}bg-primary text-white{{/issubtype}}">
                                    {{typelabel}}
                                </span>
                            </td>
                            <td class="col-datestart text-nowrap {{^interactive}}date-cell-disabled{{/interactive}}"{{#interactive}} role="button" title="{{#interactreason}}{{interactreason}}{{/interactreason}}{{^interactreason}}{{#str}}clicktoeditdate, local_reschedule{{/str}}{{/interactreason}}" tabindex="0"{{/interactive}}{{^interactive}} aria-disabled="true" title="{{#editreason}}{{editreason}}{{/editreason}}{{^editreason}}{{#str}}noteditable, local_reschedule{{/str}}{{/editreason}}"{{/interactive}}><span class="date-text">{{startformatted}}</span>{{#editable}} <i class="fa fa-pencil text-muted ms-1 col-edit-icon small opacity-50" aria-hidden="true"></i>{{/editable}}{{#derived}} <i class="fa fa-arrows-alt text-muted ms-1 col-edit-icon small opacity-50" aria-hidden="true"></i>{{/derived}}</td>
                            {{#ismilestone}}<td class="text-muted" aria-label="{{#str}}milestone, local_reschedule{{/str}}">—</td>{{/ismilestone}}
                            {{^ismilestone}}<td class="col-dateend text-nowrap {{^interactive}}date-cell-disabled{{/interactive}}"{{#interactive}} role="button" title="{{#interactreason}}{{interactreason}}{{/interactreason}}{{^interactreason}}{{#str}}clicktoeditdate, local_reschedule{{/str}}{{/interactreason}}" tabindex="0"{{/interactive}}{{^interactive}} aria-disabled="true" title="{{#editreason}}{{editreason}}{{/editreason}}{{^editreason}}{{#str}}noteditable, local_reschedule{{/str}}{{/editreason}}"{{/interactive}}><span class="date-text">{{endformatted}}</span>{{#editable}} <i class="fa fa-pencil text-muted ms-1 col-edit-icon small opacity-50" aria-hidden="true"></i>{{/editable}}{{#derived}} <i class="fa fa-arrows-alt text-muted ms-1 col-edit-icon small opacity-50" aria-hidden="true"></i>{{/derived}}</td>{{/ismilestone}}
                            <td class="col-duration text-center text-nowrap">
                                <span class="badge bg-light text-secondary border">{{durationformatted}}</span>
                            </td>
                        </tr>
                        {{/items}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="modal fade" id="reschedule-effort-model-modal" tabindex="-1" aria-labelledby="effortModelModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow border-0">
                <div class="modal-header bg-light border-bottom">
                    <h5 class="modal-title fw-bold" id="effortModelModalLabel">
                        <i class="fa fa-cog text-primary me-2" aria-hidden="true"></i>{{#str}}effortmodeltitle, local_reschedule{{/str}}
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" data-effort-dismiss aria-label="{{#str}}closebuttontitle, moodle{{/str}}"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="row g-0">
                        <div class="col-md-5 border-end bg-light p-3">
                            <div class="text-uppercase small fw-bold text-dark mb-2 px-1">{{#str}}effortmodelchoose, local_reschedule{{/str}}</div>
                            <div class="list-group" id="effort-model-list">
                                <label class="list-group-item list-group-item-action active p-3 border rounded mb-2 d-flex align-items-center" data-model="real">
                                    <input class="form-check-input me-3 flex-shrink-0" type="radio" name="effort_model" value="real" checked>
                                    <span><strong>{{#str}}effortmodelreal, local_reschedule{{/str}}</strong><br><small>{{#str}}effortmodelrealshort, local_reschedule{{/str}}</small></span>
                                </label>
                                <label class="list-group-item list-group-item-action p-3 border rounded d-flex align-items-center" data-model="ideal">
                                    <input class="form-check-input me-3 flex-shrink-0" type="radio" name="effort_model" value="ideal">
                                    <span><strong>{{#str}}effortmodelideal, local_reschedule{{/str}}</strong><br><small>{{#str}}effortmodelidealshort, local_reschedule{{/str}}</small></span>
                                </label>
                            </div>
                        </div>
                        <div class="col-md-7 p-4">
                            <div id="effort-model-desc-real" class="effort-model-desc">
                                <h5 class="fw-bold text-dark">{{#str}}effortmodelreal, local_reschedule{{/str}}</h5>
                                <p class="text-dark mb-2">{{#str}}effortmodelrealdesc, local_reschedule{{/str}}</p>
                            </div>
                            <div id="effort-model-desc-ideal" class="effort-model-desc d-none">
                                <h5 class="fw-bold text-primary">{{#str}}effortmodelideal, local_reschedule{{/str}}</h5>
                                <p class="text-dark mb-2">{{#str}}effortmodelidealdesc, local_reschedule{{/str}}</p>
                            </div>
                            <div class="alert alert-info small mb-0" role="note">{{#str}}effortmodelnote, local_reschedule{{/str}}</div>
                        </div>
                    </div>
                    <details class="quest-effort-academic border-top bg-light">
                        <summary class="quest-effort-academic-summary d-flex align-items-center justify-content-between px-4 py-3 text-dark">
                            <span class="h6 fw-bold mb-0">{{#str}}effortchallengeheading, local_reschedule{{/str}}</span>
                            <i class="fa fa-chevron-down quest-effort-academic-chevron ms-2" aria-hidden="true"></i>
                        </summary>
                        <div class="px-4 pb-3 text-dark">
                            <blockquote class="border-start border-3 border-primary ps-3 mb-0 small">
                                <p class="mb-2">{{#str}}effortchallengeintro, local_reschedule{{/str}}</p>
                                <p class="mb-2">{{#str}}effortchallengeevidence, local_reschedule{{/str}}</p>
                                <p class="mb-0">{{#str}}effortchallengeaction, local_reschedule{{/str}}</p>
                            </blockquote>
                            <div class="small mt-2">
                                {{#str}}effortchallengerefs, local_reschedule{{/str}}:
                                <a href="https://books.google.com/books/about/Parkinson_s_Law_and_Other_Studies_in_Adm.html?id=_PAaAAAAMAAJ" target="_blank" rel="noopener noreferrer">Parkinson (1957)</a>,
                                <a href="https://www.routledge.com/Critical-Chain-A-Business-Novel/Goldratt/p/book/9781138461079" target="_blank" rel="noopener noreferrer">Goldratt (1997)</a>,
                                <a href="https://pubmed.ncbi.nlm.nih.gov/17201571/" target="_blank" rel="noopener noreferrer">Steel (2007)</a>,
                                <a href="https://journals.sagepub.com/doi/10.1111/j.1467-9280.1997.tb00460.x" target="_blank" rel="noopener noreferrer">Tice &amp; Baumeister (1997)</a>,
                                <a href="https://www.psychologicalscience.org/journals/psychological-science/1467-9280.00441/" target="_blank" rel="noopener noreferrer">Ariely &amp; Wertenbroch (2002)</a>,
                                <a href="https://pubmed.ncbi.nlm.nih.gov/16719566/" target="_blank" rel="noopener noreferrer">Cepeda et al. (2006)</a>.
                            </div>
                        </div>
                    </details>
                </div>
                <div class="modal-footer bg-light border-top">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal" data-effort-dismiss>{{#str}}cancel, moodle{{/str}}</button>
                    <button type="button" class="btn btn-primary btn-sm" id="btn-effort-model-apply">{{#str}}apply, local_reschedule{{/str}}</button>
                </div>
            </div>
        </div>
    </div>

    {{#showweekify}}
    <div class="modal fade" id="reschedule-weekify-modal" tabindex="-1" aria-labelledby="weekifyModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow border-0">
                <div class="modal-header bg-light border-bottom">
                    <h5 class="modal-title fw-bold" id="weekifyModalLabel">
                        <i class="fa fa-calendar text-primary me-2" aria-hidden="true"></i>{{#str}}weekifytitle, local_reschedule{{/str}}
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{#str}}closebuttontitle, moodle{{/str}}"></button>
                </div>
                <div class="modal-body p-4">
                    <p>{{#str}}weekifyintro, local_reschedule{{/str}}</p>
                    <div class="alert alert-info small" role="note">{{#str}}weekifynote, local_reschedule{{/str}}</div>
                    <div id="weekify-preview-status" class="mb-2" role="status"></div>
                    <ul class="list-group small mb-3" id="weekify-preview-list"></ul>
                    <div class="small text-muted" id="weekify-preview-skipped">
                        <span id="weekify-undated">0</span> {{#str}}weekifyundated, local_reschedule{{/str}} ·
                        <span id="weekify-outofrange">0</span> {{#str}}weekifyoutofrange, local_reschedule{{/str}} ·
                        <span id="weekify-already">0</span> {{#str}}weekifyalready, local_reschedule{{/str}} ·
                        <span id="weekify-unsupported">0</span> {{#str}}weekifyunsupported, local_reschedule{{/str}}
                    </div>
                </div>
                <div class="modal-footer bg-light border-top">
                    <button type="button" class="btn btn-secondary btn-sm" id="btn-weekify-cancel" data-bs-dismiss="modal">
                        {{#str}}cancel, moodle{{/str}}
                    </button>
                    <button type="button" class="btn btn-primary btn-sm" id="btn-weekify-apply" disabled>
                        {{#str}}weekifyconfirm, local_reschedule{{/str}}
                    </button>
                </div>
            </div>
        </div>
    </div>
    {{/showweekify}}

    <!-- Auto-sequence Strategy Chooser Modal (Question-type chooser style) -->
    <div class="modal fade" id="reschedule-autosequence-modal" tabindex="-1" aria-labelledby="autosequenceModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow border-0">
                <div class="modal-header bg-light border-bottom">
                    <h5 class="modal-title fw-bold text-dark" id="autosequenceModalLabel">
                        <i class="fa fa-magic text-primary me-2" aria-hidden="true"></i>{{#str}}autosequencetitle, local_reschedule{{/str}}
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{#str}}closebuttontitle, moodle{{/str}}"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="container-fluid p-0">
                        <div class="row g-0">
                            <!-- Left Column: Strategy Options List -->
                            <div class="col-md-5 border-end bg-light p-3">
                                <div class="text-uppercase small fw-bold text-muted mb-2 px-1">
                                    {{#str}}choosestrategy, local_reschedule{{/str}}
                                </div>
                                <div class="list-group" id="autosequence-strategy-list" role="tablist">
                                    <label class="list-group-item list-group-item-action active cursor-pointer p-3 border rounded mb-2 d-flex align-items-center" data-strategy="equal">
                                        <input class="form-check-input me-3 flex-shrink-0" type="radio" name="autosequence_strategy" value="equal" checked{{^editing}} disabled{{/editing}}>
                                        <div>
                                            <div class="fw-bold text-dark"><i class="fa fa-balance-scale text-primary me-1" aria-hidden="true"></i> {{#str}}strategy_equal, local_reschedule{{/str}}</div>
                                            <div class="smaller text-muted">{{#str}}strategy_equal_short, local_reschedule{{/str}}</div>
                                        </div>
                                    </label>
                                    <label class="list-group-item list-group-item-action cursor-pointer p-3 border rounded mb-2 d-flex align-items-center" data-strategy="sequential">
                                        <input class="form-check-input me-3 flex-shrink-0" type="radio" name="autosequence_strategy" value="sequential"{{^editing}} disabled{{/editing}}>
                                        <div>
                                            <div class="fw-bold text-dark"><i class="fa fa-link text-success me-1" aria-hidden="true"></i> {{#str}}strategy_sequential, local_reschedule{{/str}}</div>
                                            <div class="smaller text-muted">{{#str}}strategy_sequential_short, local_reschedule{{/str}}</div>
                                        </div>
                                    </label>
                                    <label class="list-group-item list-group-item-action cursor-pointer p-3 border rounded d-flex align-items-center" data-strategy="proportional">
                                        <input class="form-check-input me-3 flex-shrink-0" type="radio" name="autosequence_strategy" value="proportional"{{^editing}} disabled{{/editing}}>
                                        <div>
                                            <div class="fw-bold text-dark"><i class="fa fa-sliders text-info me-1" aria-hidden="true"></i> {{#str}}strategy_proportional, local_reschedule{{/str}}</div>
                                            <div class="smaller text-muted">{{#str}}strategy_proportional_short, local_reschedule{{/str}}</div>
                                        </div>
                                    </label>
                                    <label class="list-group-item list-group-item-action cursor-pointer p-3 border rounded d-flex align-items-center" data-strategy="relative">
                                        <input class="form-check-input me-3 flex-shrink-0" type="radio" name="autosequence_strategy" value="relative"{{^editing}} disabled{{/editing}}>
                                        <div>
                                            <div class="fw-bold text-dark"><i class="fa fa-arrows-h text-warning me-1" aria-hidden="true"></i> {{#str}}strategy_relative, local_reschedule{{/str}}</div>
                                            <div class="smaller text-muted">{{#str}}strategy_relative_short, local_reschedule{{/str}}</div>
                                        </div>
                                    </label>
                                </div>
                                <div class="form-check mt-3 px-1 ps-4">
                                    <input class="form-check-input" type="checkbox" id="autosequence-avoid-blackout"{{^editing}} disabled{{/editing}}>
                                    <label class="form-check-label fw-semibold text-dark" for="autosequence-avoid-blackout">
                                        {{#str}}autosequenceavoidblackout, local_reschedule{{/str}}
                                    </label>
                                    <div class="small text-secondary mt-1">
                                        {{#str}}autosequenceavoidblackoutinfo, local_reschedule{{/str}}
                                    </div>
                                </div>
                                <div class="alert alert-info small mt-3 mb-0" role="note">
                                    {{#str}}autosequenceonlydated, local_reschedule{{/str}}
                                </div>
                            </div>
                            <!-- Right Column: Strategy Description -->
                            <div class="col-md-7 p-4 d-flex flex-column justify-content-between bg-white" id="autosequence-description-panel" style="min-height: 280px;">
                                <div id="strategy-desc-equal" class="strategy-desc-content">
                                    <h5 class="fw-bold text-primary mb-3">
                                        <i class="fa fa-balance-scale me-2" aria-hidden="true"></i>{{#str}}strategy_equal, local_reschedule{{/str}}
                                    </h5>
                                    <p class="text-secondary mb-3">
                                        {{#str}}strategy_equal_desc, local_reschedule{{/str}}
                                    </p>
                                    <div class="alert alert-light border small text-muted mb-0">
                                        <i class="fa fa-info-circle text-primary me-1" aria-hidden="true"></i>
                                        {{#str}}strategy_equal_tip, local_reschedule{{/str}}
                                    </div>
                                </div>
                                <div id="strategy-desc-sequential" class="strategy-desc-content d-none">
                                    <h5 class="fw-bold text-success mb-3">
                                        <i class="fa fa-link me-2" aria-hidden="true"></i>{{#str}}strategy_sequential, local_reschedule{{/str}}
                                    </h5>
                                    <p class="text-secondary mb-3">
                                        {{#str}}strategy_sequential_desc, local_reschedule{{/str}}
                                    </p>
                                    <div class="alert alert-light border small text-muted mb-0">
                                        <i class="fa fa-info-circle text-success me-1" aria-hidden="true"></i>
                                        {{#str}}strategy_sequential_tip, local_reschedule{{/str}}
                                    </div>
                                </div>
                                <div id="strategy-desc-proportional" class="strategy-desc-content d-none">
                                    <h5 class="fw-bold text-info mb-3">
                                        <i class="fa fa-sliders me-2" aria-hidden="true"></i>{{#str}}strategy_proportional, local_reschedule{{/str}}
                                    </h5>
                                    <p class="text-secondary mb-3">
                                        {{#str}}strategy_proportional_desc, local_reschedule{{/str}}
                                    </p>
                                    <div class="alert alert-light border small text-muted mb-0">
                                        <i class="fa fa-info-circle text-info me-1" aria-hidden="true"></i>
                                        {{#str}}strategy_proportional_tip, local_reschedule{{/str}}
                                    </div>
                                </div>
                                <div id="strategy-desc-relative" class="strategy-desc-content d-none">
                                    <h5 class="fw-bold text-warning mb-3">
                                        <i class="fa fa-arrows-h me-2" aria-hidden="true"></i>{{#str}}strategy_relative, local_reschedule{{/str}}
                                    </h5>
                                    <p class="text-secondary mb-3">
                                        {{#str}}strategy_relative_desc, local_reschedule{{/str}}
                                    </p>
                                    <div class="alert alert-light border small text-muted mb-0">
                                        <i class="fa fa-info-circle text-warning me-1" aria-hidden="true"></i>
                                        {{#str}}strategy_relative_tip, local_reschedule{{/str}}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top">
                    <button type="button" class="btn btn-secondary btn-sm" id="btn-autosequence-cancel" data-bs-dismiss="modal">
                        {{#str}}cancel, moodle{{/str}}
                    </button>
                    <button type="button" class="btn btn-primary btn-sm px-3" id="btn-autosequence-apply"{{^editing}} disabled{{/editing}}>
                        <i class="fa fa-check me-1" aria-hidden="true"></i>{{#str}}apply, local_reschedule{{/str}}
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Dates Modal (Standard Moodle datetime-local form modal) -->
    <div class="modal fade" id="reschedule-date-modal" tabindex="-1" aria-labelledby="dateModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow border-0">
                <div class="modal-header bg-light border-bottom">
                    <h5 class="modal-title fw-bold text-dark" id="dateModalLabel">
                        <i class="fa fa-calendar-check-o text-primary me-2" aria-hidden="true"></i>
                        <span id="date-modal-activity-title">{{#str}}editdatesmodal, local_reschedule{{/str}}</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{#str}}closebuttontitle, moodle{{/str}}"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" id="date-modal-itemid" value="">
                    <div class="mb-3 d-flex align-items-center justify-content-between">
                        <span class="badge bg-primary text-white" id="date-modal-badge-type"></span>
                        <span class="badge bg-light text-secondary border" id="date-modal-badge-duration"></span>
                    </div>
                    <div class="alert alert-danger d-none py-2 px-3 mb-3 small" id="date-modal-error">
                        <i class="fa fa-exclamation-circle me-1" aria-hidden="true"></i>
                        <span id="date-modal-error-text"
                            data-order-message="{{#str}}invaliddateorder, local_reschedule{{/str}}"
                            data-required-message="{{#str}}datefieldrequired, local_reschedule{{/str}}">{{#str}}invaliddateorder, local_reschedule{{/str}}</span>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <label for="date-modal-start" class="form-label fw-bold small text-dark mb-1">
                                <i class="fa fa-play text-success me-1" aria-hidden="true"></i>
                                <span id="date-modal-start-label">{{#str}}datestart, local_reschedule{{/str}}</span>
                            </label>
                            <div class="form-check mb-1" id="date-modal-start-toggle">
                                <input type="checkbox" class="form-check-input" id="date-modal-start-enabled" checked{{^editing}} disabled{{/editing}}>
                                <label for="date-modal-start-enabled" class="form-check-label small">{{#str}}enablestartdate, local_reschedule{{/str}}</label>
                            </div>
                        </div>
                        <input type="datetime-local" class="form-control" id="date-modal-start" required{{^editing}} disabled{{/editing}}>
                    </div>
                    <div class="form-check mb-3 d-none" id="date-modal-milestone-toggle">
                        <input type="checkbox" class="form-check-input" id="date-modal-milestone-enabled"{{^editing}} disabled{{/editing}}>
                        <label for="date-modal-milestone-enabled" class="form-check-label">{{#str}}enablemilestone, local_reschedule{{/str}}</label>
                    </div>
                    <div class="mb-3" id="date-modal-end-group">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <label for="date-modal-end" class="form-label fw-bold small text-dark mb-1">
                                <i class="fa fa-stop text-danger me-1" aria-hidden="true"></i>
                                {{#str}}dateend, local_reschedule{{/str}}
                            </label>
                            <div class="form-check mb-1" id="date-modal-end-toggle">
                                <input type="checkbox" class="form-check-input" id="date-modal-end-enabled" checked{{^editing}} disabled{{/editing}}>
                                <label for="date-modal-end-enabled" class="form-check-label small">{{#str}}enableenddate, local_reschedule{{/str}}</label>
                            </div>
                        </div>
                        <input type="datetime-local" class="form-control" id="date-modal-end" required{{^editing}} disabled{{/editing}}>
                    </div>
                    <div class="alert alert-light border small text-muted mb-0">
                        <i class="fa fa-info-circle text-primary me-1" aria-hidden="true"></i>
                        {{#str}}editdatesmodaltip, local_reschedule{{/str}}
                    </div>
                </div>
                <div class="modal-footer bg-light border-top">
                    <button type="button" class="btn btn-secondary btn-sm" id="btn-date-modal-cancel" data-bs-dismiss="modal">
                        {{#str}}cancel, moodle{{/str}}
                    </button>
                    <button type="button" class="btn btn-primary btn-sm px-3" id="btn-date-modal-apply"{{^editing}} disabled{{/editing}}>
                        <i class="fa fa-check me-1" aria-hidden="true"></i>{{#str}}apply, local_reschedule{{/str}}
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Embedded Activities Data -->
    <script type="application/json" id="reschedule-activities-data">
        {{{itemsjson}}}
    </script>
    {{/hasitems}}
</div>
